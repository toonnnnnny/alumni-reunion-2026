# ใส่ URL ของโปรเจกต์ MockAPI (ไม่มี / ท้าย) เช่น https://6xxxxxxx.mockapi.io/api/v1
# ถ้าเว้นว่าง เว็บจะใช้ MockAPI จำลองในเครื่อง (/api/mock) แทน
NEXT_PUBLIC_API_BASE=

# ส่งอีเมลบัตรจริงผ่าน Resend (resend.com -> API Keys)
RESEND_API_KEY=
# ผู้ส่ง: ยังไม่ยืนยันโดเมน ใช้ onboarding@resend.dev ได้ แต่ส่งได้แค่อีเมลที่สมัคร Resend
RESEND_FROM=Alumni Reunion 2026 <onboarding@resend.dev>
# โดเมนของเว็บ ใช้สร้างลิงก์ในอีเมล (เว้นว่าง = ใช้โดเมนที่เปิดอยู่)
NEXT_PUBLIC_SITE_URL=
# โหมดทดสอบ: ส่งอีเมลทุกฉบับไปที่อีเมลนี้แทนผู้ซื้อ (ใช้ตอนยังไม่ยืนยันโดเมน ใส่อีเมลที่สมัคร Resend)
RESEND_TEST_TO=
